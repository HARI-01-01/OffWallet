[Unit]
Description=Offline Payment Backend API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/offline-payment-system/crypto/backend/src
EnvironmentFile=/opt/offline-payment-system/crypto/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/offline-payment-system/crypto/backend/src
ExecStart=/opt/offline-payment-system/crypto/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target