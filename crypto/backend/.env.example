# Database
DATABASE_URL=sqlite:///./offline_wallet.db

# Security (Replace with secure random hex strings)
SECRET_KEY=your_secret_key_here
API_KEY=your_api_key_here

# Firebase
FIREBASE_CREDENTIALS=firebase-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
FIREBASE_PROJECT_ID=offlinewallet-aeda2

# Redis
REDIS_URL=redis://redis:6379

# Rate Limiting
RATE_LIMIT=100
RATE_WINDOW=60

# Server
PORT=8000
HOST=0.0.0.0
