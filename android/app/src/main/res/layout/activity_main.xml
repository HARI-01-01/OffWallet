<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/customAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/userAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pin_input"
            android:backgroundTint="#1B1E27"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/avatarInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="H"
            android:textColor="#8FA4FF"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/userAvatar"
            app:layout_constraintEnd_toEndOf="@id/userAvatar"
            app:layout_constraintTop_toTopOf="@id/userAvatar"
            app:layout_constraintBottom_toBottomOf="@id/userAvatar"/>

        <LinearLayout
            android:id="@+id/userInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/userAvatar"
            app:layout_constraintEnd_toStartOf="@id/appActions"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hari"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:letterSpacing="-0.01"/>

            <TextView
                android:id="@+id/headerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hariyadav01012005@gmail.com"
                android:textColor="@color/gray_label"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_round"
                android:backgroundTint="#15171F"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="@color/white"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Mini System Status Bar -->
    <LinearLayout
        android:id="@+id/systemStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/customAppBar">

        <TextView
            android:id="@+id/tvBleStatusMini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLE: OFF"
            android:textColor="@color/gray_label"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvBackendStatusMini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BACKEND: CHECKING..."
            android:textColor="@color/pending_orange"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Offline Mode Banner -->
    <LinearLayout
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E1C0F"
        android:paddingVertical="8dp"
        android:paddingHorizontal="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/systemStatus">
        <TextView
            android:id="@+id/tvOfflineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📴 Offline Mode · Secure Hardware Active"
            android:textColor="#F2B34C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"/>
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/offlineBanner"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="24dp">

            <!-- Premium Balance Card -->
            <FrameLayout
                android:id="@+id/balShell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rim"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bal_card_inner"
                    android:padding="18dp">

                    <LinearLayout
                        android:id="@+id/balanceHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:background="@drawable/bg_card_rim"
                            android:layout_marginEnd="9dp"/>

                        <TextView
                            android:id="@+id/balanceLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Available Offline"
                            android:textColor="#3A3D48"
                            android:textStyle="bold"
                            android:textSize="13sp"/>

                        <ImageView
                            android:id="@+id/ivExpandBalance"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@android:drawable/ic_menu_more"
                            app:tint="#9EA3B0"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/balanceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="₹4,630.00"
                        android:textColor="@color/black"
                        android:textSize="39sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.04"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E4ED"
                        android:layout_marginVertical="12dp"/>

                    <LinearLayout
                        android:id="@+id/balanceDetailsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Server Balance (Synced)"
                                android:textColor="@color/gray_label"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/settledText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹4,624.00"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pending Reserve"
                                android:textColor="@color/gray_label"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/reserveText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹6.00"
                                android:textColor="@color/pending_orange"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Current Offline Spending"
                                android:textColor="@color/gray_label"
                                android:textSize="12sp"/>
                            <TextView
                                android:id="@+id/provisionalText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0.00"
                                android:textColor="@color/action_blue_start"
                                android:textStyle="bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutStaleReserve"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:visibility="gone">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Stale reservation cleared"
                                android:textColor="@color/action_blue_start"
                                android:textSize="10sp"
                                android:textStyle="italic"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F2F8"
                            android:layout_marginVertical="6dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/capacityLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvTxCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Transactions Used: 0 / 10"
                                android:textColor="@color/gray_label"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"/>
                            <TextView
                                android:id="@+id/capacityValueText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹0 / ₹2,000"
                                android:textColor="@color/black"
                                android:textSize="10sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/capacityProgressBar"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/bg_capacity_progress"/>

                        <TextView
                            android:id="@+id/tvLastSettled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Last Settled: Never"
                            android:textColor="@color/gray_label"
                            android:textSize="9sp"
                            android:textStyle="italic"
                            android:gravity="end"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ready for offline payments"
                        android:textColor="@color/gray_label"
                        android:textSize="11sp"
                        android:visibility="gone"/>

                    <Button
                        android:id="@+id/btnResolveSecurity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Resolve Security Violation"
                        android:visibility="gone"
                        android:backgroundTint="@color/outgoing_red"
                        android:textColor="@color/white"
                        style="@style/Widget.Material3.Button.TonalButton"/>

                    <Button
                        android:id="@+id/loadLiteBtn"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:text="Top up Vault"
                        android:backgroundTint="#EFF1F6"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:icon="@android:drawable/ic_input_add"
                        app:iconTint="@color/black"
                        style="@style/Widget.Material3.Button.TonalButton"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Pending Resolution Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#2E1C0F"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️"
                            android:textSize="20sp"
                            android:layout_marginEnd="12dp"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pending Resolution"
                            android:textColor="#F2B34C"
                            android:textStyle="bold"
                            android:textSize="16sp"/>
                        <Button
                            android:id="@+id/btnResolveAll"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Resolve"
                            android:textSize="10sp"
                            android:paddingHorizontal="8dp"
                            android:backgroundTint="#F2B34C"
                            android:textColor="#2E1C0F"
                            style="@style/Widget.Material3.Button.TonalButton"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="One or more transactions are in 'Doubtful' state. Sync to resolve with the server's record of the recipient."
                        android:textColor="#F2B34C"
                        android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPayAction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#13151D"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💸" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pay" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/white"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnReceiveAction"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#13151D"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📥" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Receive" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/white"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnExplorerActionMain"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#13151D"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔗" android:textSize="24sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Node Graph (Blockchain)" android:textStyle="bold" android:layout_marginTop="4dp" android:textColor="@color/white"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSyncAction"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1D26"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔄" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Synchronize Offline Ledger" android:textStyle="bold" android:textColor="@color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnProtocolLab"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#1A1D26"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧪" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protocol Test Center" android:textStyle="bold" android:textColor="@color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Activity -->
            <LinearLayout
                android:id="@+id/historyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent activity"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/btnSeeAllHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textColor="@color/gray_label"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_transaction"/>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Custom Bottom Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chip"
        android:backgroundTint="#12141C"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/homeTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@android:drawable/ic_menu_today" app:tint="#8FA4FF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="#8FA4FF" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activityTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@android:drawable/ic_menu_recent_history" app:tint="#585D6D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Activity" android:textColor="#585D6D" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <View
                android:id="@+id/fabSpace"
                android:layout_width="60dp"
                android:layout_height="match_parent"/>

            <LinearLayout
                android:id="@+id/vaultTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@android:drawable/ic_lock_idle_lock" app:tint="#585D6D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vault" android:textColor="#585D6D" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#585D6D"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="#585D6D" android:textSize="10sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mainFab"
            android:layout_width="54dp"
            android:layout_height="54dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/action_blue_start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="-20dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/white"/>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
