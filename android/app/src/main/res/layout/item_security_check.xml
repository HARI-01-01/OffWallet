<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivCheckStatus"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_check_circle"
        android:contentDescription="Status" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <TextView
            android:id="@+id/tvCheckTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardware Keystore"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCheckDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keys are stored in a tamper-resistant chip"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCheckLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECURE"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/success"
        android:background="@drawable/bg_label_success"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp" />

</LinearLayout>
