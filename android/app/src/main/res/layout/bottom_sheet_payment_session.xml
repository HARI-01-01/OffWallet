<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background"
    android:gravity="center_horizontal">

    <!-- GPay Style Payee Avatar -->
    <FrameLayout
        android:id="@+id/avatarLayout"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_avatar_circle">
        <TextView
            android:id="@+id/tvPayeeInitials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="A"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvPeerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Paying Recipient"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvSessionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="₹0.00"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <!-- Stepped Progress Icons -->
    <LinearLayout
        android:id="@+id/stepLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStepDiscovery"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/presence_online"
            app:tint="@color/gray_label"/>
        <View android:layout_width="32dp" android:layout_height="1dp" android:background="@color/gray_700" android:layout_marginHorizontal="8dp"/>
        <ImageView
            android:id="@+id/ivStepIdentity"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            app:tint="@color/gray_label"/>
        <View android:layout_width="32dp" android:layout_height="1dp" android:background="@color/gray_700" android:layout_marginHorizontal="8dp"/>
        <ImageView
            android:id="@+id/ivStepSecurity"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="@color/gray_label"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSessionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Connecting..."
        android:textColor="@color/gray_label"
        android:textSize="15sp"
        android:gravity="center"/>

    <!-- Progress / Success Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="8dp">

        <ProgressBar
            android:id="@+id/progressSessionCircular"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/action_blue_start" />

        <FrameLayout
            android:id="@+id/successContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:visibility="gone">
            <View
                android:id="@+id/vSuccessBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_success_circle"/>
            <ImageView
                android:id="@+id/ivSuccessCheck"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="@color/white"/>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvSessionDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Establishing secure tunnel..."
        android:textColor="@color/gray_label"
        android:textSize="13sp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvResolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="@color/warning"
        android:textSize="12sp"
        android:gravity="center"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnSessionClose"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="Done"
        android:visibility="gone"
        app:cornerRadius="27dp"
        style="@style/Widget.Material3.Button.TonalButton"/>
</LinearLayout>
