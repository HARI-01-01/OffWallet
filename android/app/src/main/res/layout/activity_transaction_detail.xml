<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/bg_pin_input"
            android:backgroundTint="#15171F"
            app:tint="@color/gray_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid details"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16.5sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="@drawable/bg_pin_input"
            android:backgroundTint="#15171F"
            app:tint="@color/gray_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="More"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/detailAppBar"
        app:layout_constraintBottom_toTopOf="@id/ctaContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingBottom="24dp">

            <!-- Small Balance Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rim"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_bal_card_inner"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total balance"
                        android:textColor="#3A3D48"
                        android:textStyle="bold"
                        android:textSize="13.5sp"/>

                    <TextView
                        android:id="@+id/tvCurrentBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="₹4,380.00"
                        android:textColor="@color/black"
                        android:textSize="32sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid to"
                android:textColor="@color/gray_label"
                android:textSize="11sp"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tvTargetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="user_37c63e1e"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"/>

            <!-- Detail Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#12141B"
                    android:padding="14dp"
                    android:layout_marginBottom="9dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paid with" android:textColor="#666B7B" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvMethod" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline wallet · device key" android:textColor="@color/white" android:textSize="14.5sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:src="@android:drawable/ic_menu_save" app:tint="@color/verified_green"/>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#12141B"
                    android:padding="14dp"
                    android:layout_marginBottom="9dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Amount" android:textColor="#666B7B" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹250.00" android:textColor="@color/white" android:textSize="14.5sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#12141B"
                    android:padding="14dp"
                    android:layout_marginBottom="9dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chain position" android:textColor="#666B7B" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvChainPos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Block #7 · 2 confirmations" android:textColor="@color/white" android:textSize="14.5sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#12141B"
                    android:padding="14dp"
                    android:layout_marginBottom="9dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Block hash" android:textColor="#666B7B" android:textSize="11sp"/>
                        <TextView android:id="@+id/tvBlockHash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4f9a2c...e18b7d" android:textColor="#C3C7D2" android:textSize="12.5sp" android:fontFamily="monospace" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                    <ImageView android:layout_width="17dp" android:layout_height="17dp" android:src="@android:drawable/ic_menu_save" app:tint="#6B7080"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnViewOnChain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="View in Blockchain Explorer"
                    android:backgroundTint="#15171F"
                    android:textColor="@color/white"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/white"
                    style="@style/Widget.Material3.Button.TonalButton"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/ctaContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_rim"
            android:padding="2dp">
            <Button
                android:id="@+id/btnSaveReceipt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Save receipt as PDF"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="14.5sp"
                android:backgroundTint="#F4F5F8"
                app:cornerRadius="15dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
        </FrameLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
