<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvVaultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Vault"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvVaultSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hardware-anchored recovery keys"
        android:textColor="@color/gray_label"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvVaultTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMnemonic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="#15171F"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvVaultSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24-Word Recovery Phrase"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMnemonicPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#0A0B0F"
                android:padding="16dp"
                android:text="•••• •••• •••• •••• •••• ••••"
                android:textColor="@color/gray_text"
                android:gravity="center"
                android:letterSpacing="0.2"/>

            <Button
                android:id="@+id/btnRevealMnemonic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reveal Phrase"
                style="@style/Widget.Material3.Button.TonalButton"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCloudBackup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#15171F"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardMnemonic">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloud Recovery Shard"
                    android:textColor="@color/white"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvBackupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backed up to Secure Cloud"
                    android:textColor="@color/verified_green"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/verified_green"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/Widget.Material3.Button.TextButton"/>

</androidx.constraintlayout.widget.ConstraintLayout>
