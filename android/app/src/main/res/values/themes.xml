<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.OfflineWallet" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/action_blue_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/raised</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/verified_green</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/surface_dark</item>

        <!-- Customize your theme here. -->
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Shadow Base Styles -->
    <style name="Widget.Shadow" parent="" />

    <!-- Shadow Card Style -->
    <style name="Widget.Shadow.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#1B1E26</item>
    </style>

    <!-- Action Tile Style -->
    <style name="Widget.Shadow.ActionTile" parent="Widget.Shadow.Card">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">#13151D</item>
        <item name="strokeColor">#22252F</item>
    </style>

    <!-- Status Chip Style -->
    <style name="Widget.Shadow.Chip">
        <item name="android:layout_height">26dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/action_blue_start</item>
    </style>

    <style name="NfcPaymentDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <!-- Radar UI Styles -->
    <style name="RadarCircle">
        <item name="android:background">@drawable/bg_radar_circle</item>
    </style>

    <style name="RadarCircle.Large">
        <item name="android:backgroundTint">#2A3358</item>
    </style>

    <style name="RadarCircle.Medium">
        <item name="android:backgroundTint">#33407A</item>
    </style>

    <style name="RadarCircle.Small">
        <item name="android:backgroundTint">#4055A8</item>
    </style>
</resources>
